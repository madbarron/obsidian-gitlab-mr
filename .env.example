# Copy to .env (git-ignored). Everything here is optional.

# Where `npm run dev` / `npm run build` write the plugin.
# Point at a vault — relative paths resolve from your home directory, and the
# .obsidian/plugins/<plugin-id> part is added for you:
OBSIDIAN_VAULT=Obsidian/MyVault
# ...or name the plugin folder outright, which wins over OBSIDIAN_VAULT:
# OBSIDIAN_PLUGIN_DIR=~/Obsidian/MyVault/.obsidian/plugins/obsidian-gitlab-mr
# With neither set, the build goes to ./dist.

# Only used by `npm run probe` — the plugin itself reads its token from Obsidian settings.
GITLAB_BASE_URL=https://gitlab.com
GITLAB_GROUP_BASE=org/group
GITLAB_TOKEN=
